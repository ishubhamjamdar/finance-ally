# FinAlly configuration. Copy to .env and fill in what you need:
#
#     cp .env.example .env
#
# Only OPENROUTER_API_KEY has no working default, and the app runs without it —
# you get live simulated prices and a chat panel that reports the provider is
# unavailable. Everything else below can stay exactly as it is.
#
# .env is gitignored and excluded from the Docker build context; the container
# receives these at run time via --env-file (PLAN.md §5, §11).

# Required for the AI chat. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) key for real market data. Left empty, the
# built-in GBM simulator runs instead — which is the recommended default.
MASSIVE_API_KEY=

# Optional: "true" returns deterministic mock LLM replies with no network call
# and no key. Used by the E2E suite and the smoke scripts.
LLM_MOCK=false

# Optional paths and logging. All three are read at call time and all three
# have working defaults; the image sets DB_PATH and STATIC_DIR itself, so
# setting them here is only meaningful when running from a source checkout.
# DB_PATH=
# STATIC_DIR=
LOG_LEVEL=INFO

# Frontend, build time only, and inlined into the bundle — never put anything
# secret here. Empty in production: the export and the API share an origin.
# Set it for `next dev`, which serves the UI on :3000 against an API on :8000.
# NEXT_PUBLIC_API_BASE=http://localhost:8000
